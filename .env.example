# ============================================================
# UMUM
# ============================================================
# Zona waktu container (dipakai timestamp log & SQLite).
TZ=Asia/Makassar

# ============================================================
# TELEGRAM BOT (dari @BotFather)
# ============================================================
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ============================================================
# SMART PLUG - BARDI Smart Plug 16A (COK AIR)
# ============================================================
DEVICE_AIR_ID=your_id
DEVICE_AIR_KEY=your_local_key_here
DEVICE_AIR_IP=your_ip
DEVICE_AIR_VER=device_ver

# ============================================================
# SMART LAMP - BARDI Smart Light Bulb 12W RGBWW
# ============================================================
DEVICE_LAMPU_ID=your_id
DEVICE_LAMPU_KEY=your_local_key_here
DEVICE_LAMPU_IP=your_ip
DEVICE_LAMPU_VER=device_ver

# ============================================================
# ROLE-BASED ACCESS CONTROL (RBAC)
# ============================================================
# Di file .env HANYA Superadmin yang didaftarkan.
# User & Admin didaftarkan langsung oleh Superadmin lewat Telegram
# (otomatis tersimpan ke tabel bot_users di SQLite).
#
# Format: id1,id2,id3 (tanpa spasi)
# Contoh (dummy): 123456789,987654321
SUPERADMIN_USERS=123456789


# ============================================================
# RATE LIMIT — proteksi dari spam & abuse
# Jumlah request maksimal dalam window (detik) per role
# ============================================================
RATE_LIMIT_PUBLIC=10
RATE_LIMIT_USER=30
RATE_LIMIT_ADMIN=60
RATE_LIMIT_SUPERADMIN=120
RATE_LIMIT_WINDOW=60

# ============================================================
# WEB DASHBOARD API (lokal)
# ============================================================
# API key untuk dashboard & REST client (header: X-API-Key)
DASHBOARD_API_KEY=your_secret_api_key_here
# Alamat bind API dashboard (satu-satunya tempat mengubahnya — bukan di compose).
#   127.0.0.1        = hanya bisa dibuka dari dalam host (paling aman, perlu SSH tunnel)
#   10.0.0.2        = contoh alamat WireGuard VPS (ganti dengan alamat tunnel Anda)
#   0.0.0.0          = JANGAN di VPS ber-IP publik
API_HOST=127.0.0.1
API_PORT=8080
# Swagger docs — default OFF. Set true hanya untuk development lokal.
API_DOCS=false

# ============================================================
# SESI DASHBOARD (Fase 5)
# ============================================================
# Dashboard login memakai API key sekali, lalu cookie HttpOnly bertanda tangan.
# Umur sesi dalam jam.
SESSION_TTL_HOURS=12
# Set true bila dashboard diakses lewat HTTPS (Cloudflare/nginx TLS).
# false agar tetap bisa dipakai lewat http:// di jaringan lokal.
SESSION_COOKIE_SECURE=false
# Kunci tanda tangan cookie. Kosong = diturunkan dari DASHBOARD_API_KEY.
# Isi bila ingin mengganti API key tanpa membatalkan semua sesi.
SESSION_SECRET=
# Interval kirim snapshot real-time (SSE) dalam detik.
STREAM_INTERVAL_SECONDS=3

# ============================================================
# MYSQL DATABASE (HANYA untuk scripts/migrate_mysql_to_sqlite.py)
# ============================================================
# Bot tidak lagi memakai MySQL. Variabel ini dibaca sekali saat migrasi data
# ke SQLite, setelah itu boleh dihapus dari .env.
# Instalasi baru (tanpa data MySQL lama) tidak perlu blok ini sama sekali.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=tuya_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=tuya_db

# ============================================================
# SQLITE DATABASE (embedded, dipakai bot)
# ============================================================
# Path file database. Direktori dibuat otomatis bila belum ada.
# Di container: /app/data/tuyabot.db (bind-mount ke ./data di host).
SQLITE_PATH=data/tuyabot.db
# Batas tunggu saat database sedang dikunci penulis lain (milidetik).
SQLITE_BUSY_TIMEOUT_MS=5000

# ============================================================
# POWER MONITORING INTERVAL (Menit)
# ============================================================
POWER_LOG_INTERVAL_MINUTES=5

# ============================================================
# LOG RETENTION & HOUSEKEEPING (Hari)
# Log daya, aktivitas, & error lebih tua dari X hari akan dibersihkan otomatis
# ============================================================
LOG_RETENTION_DAYS=60

# ============================================================
# CACHE & TIMEOUT (Fase 2)
# ============================================================
# Umur cache status/daya perangkat (detik). Pembacaan dashboard, bot, dan
# watchdog dalam rentang ini memakai satu hasil yang sama (single-flight).
STATE_CACHE_TTL_SECONDS=5
# Umur cache untuk hasil gagal (detik) — mencegah perangkat offline dibanjiri retry.
STATE_ERROR_TTL_SECONDS=2
# Seberapa sering cache dihangatkan scheduler (detik).
STATE_WARM_INTERVAL_SECONDS=60
# Batas waktu satu panggilan ke perangkat (detik). Harus lebih longgar dari
# socket timeout tinytuya (4s x 2 retry).
TUYA_CALL_TIMEOUT_SECONDS=25
# Jumlah thread untuk I/O perangkat dan untuk query database.
TUYA_THREADS=4
DB_THREADS=4
# Batas waktu satu query database (detik).
DB_CALL_TIMEOUT_SECONDS=15
# Interval housekeeping log (jam). Tidak berjalan saat startup.
HOUSEKEEPING_INTERVAL_HOURS=24

# ============================================================
# BACKUP SQLITE
# ============================================================
# Direktori salinan (di container: /app/backup, bind-mount ke ./backup).
BACKUP_DIR=backup
# Interval backup (jam). Backup pertama 15 menit setelah start.
BACKUP_INTERVAL_HOURS=24
# Salinan lebih tua dari ini dihapus otomatis.
BACKUP_RETENTION_DAYS=14


# ============================================================
# AIR AUTO-OFF WATCHDOG (Role User)
# Otomatis matikan air jika terdeteksi idle (bocor) saat dinyalakan oleh User
# ============================================================
# Ambang batas daya aktif (di bawah ini dianggap idle/bocor):
AIR_AUTO_OFF_IDLE_WATT=200
# Interval cek berkala (menit):
AIR_AUTO_OFF_CHECK_MINUTES=3
# Batas maksimal pompa boleh menyala terus menerus untuk role User (menit):
AIR_AUTO_OFF_MAX_MINUTES=30
# Jumlah sampel pembacaan daya berturut-turut saat siklus cek (default 3):
AIR_AUTO_OFF_SAMPLE_COUNT=3
# Jeda antar sampel pembacaan (detik, default 2):
AIR_AUTO_OFF_SAMPLE_DELAY_SECONDS=2





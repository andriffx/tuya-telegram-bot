# ============================================================
# TELEGRAM BOT (dari @BotFather)
# ============================================================
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ============================================================
# SMART PLUG - BARDI Smart Plug 16A (COK AIR)
# ============================================================
DEVICE_AIR_ID=your_id
DEVICE_AIR_KEY=your_local_key_here
DEVICE_AIR_IP=your_ip
DEVICE_AIR_VER=device_ver

# ============================================================
# SMART LAMP - BARDI Smart Light Bulb 12W RGBWW
# ============================================================
DEVICE_LAMPU_ID=your_id
DEVICE_LAMPU_KEY=your_local_key_here
DEVICE_LAMPU_IP=your_ip
DEVICE_LAMPU_VER=device_ver

# ============================================================
# ROLE-BASED ACCESS CONTROL (RBAC)
# ============================================================
# Di file .env HANYA Superadmin yang didaftarkan.
# User & Admin didaftarkan langsung oleh Superadmin lewat Telegram
# (otomatis tersimpan ke tabel bot_users di database MySQL).
#
# Format: id1,id2,id3 (tanpa spasi)
# ============================================================
SUPERADMIN_USERS=


# ============================================================
# RATE LIMIT — proteksi dari spam & abuse
# Jumlah request maksimal dalam window (detik) per role
# ============================================================
RATE_LIMIT_PUBLIC=10
RATE_LIMIT_USER=30
RATE_LIMIT_ADMIN=60
RATE_LIMIT_SUPERADMIN=120
RATE_LIMIT_WINDOW=60

# ============================================================
# WEB DASHBOARD API (lokal)
# ============================================================
# API key untuk dashboard & REST client (header: X-API-Key)
DASHBOARD_API_KEY=your_secret_api_key_here
API_HOST=0.0.0.0
API_PORT=8080
# Swagger docs — default OFF. Set true hanya untuk development lokal.
API_DOCS=false

# ============================================================
# MYSQL DATABASE (External)
# ============================================================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=tuya_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=tuya_db
MYSQL_POOL_SIZE=5
MYSQL_CONNECT_TIMEOUT=5

# ============================================================
# POWER MONITORING INTERVAL (Menit)
# ============================================================
POWER_LOG_INTERVAL_MINUTES=5

# ============================================================
# LOG RETENTION & HOUSEKEEPING (Hari)
# Log daya, aktivitas, & error lebih tua dari X hari akan dibersihkan otomatis
# ============================================================
LOG_RETENTION_DAYS=60

# ============================================================
# AIR AUTO-OFF WATCHDOG (Role User)
# Otomatis matikan air jika terdeteksi idle (bocor) saat dinyalakan oleh User
# ============================================================
# Ambang batas daya aktif (di bawah ini dianggap idle/bocor):
AIR_AUTO_OFF_IDLE_WATT=200
# Interval cek berkala (menit):
AIR_AUTO_OFF_CHECK_MINUTES=3
# Batas maksimal pompa boleh menyala terus menerus untuk role User (menit):
AIR_AUTO_OFF_MAX_MINUTES=30



